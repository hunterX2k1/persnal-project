<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@drawable/notif_bg" android:padding="12dp">
    <TextView android:id="@+id/n_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="16sp" android:textStyle="bold" />
    <TextView android:id="@+id/n_detail" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="13sp" android:textColor="#FF8A94B3" android:layout_marginTop="2dp"
        android:maxLines="1" android:ellipsize="end" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="10dp">
        <TextView android:id="@+id/n_power" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="36dp" android:gravity="center" android:textSize="12sp" android:textStyle="bold"
            android:layout_marginEnd="6dp" android:maxLines="1" />
        <TextView android:id="@+id/n_adblock" android:layout_width="0dp" android:layout_weight="1.3"
            android:layout_height="36dp" android:gravity="center" android:textSize="12sp" android:textStyle="bold"
            android:layout_marginEnd="6dp" android:maxLines="1" />
        <TextView android:id="@+id/n_vpn" android:layout_width="0dp" android:layout_weight="1.1"
            android:layout_height="36dp" android:gravity="center" android:textSize="12sp" android:textStyle="bold"
            android:maxLines="1" />
    </LinearLayout>
    <TextView android:id="@+id/n_kill" android:layout_width="match_parent" android:layout_height="38dp"
        android:layout_marginTop="8dp" android:gravity="center" android:background="@drawable/pill_kill"
        android:text="⚡  EMERGENCY KILL — stop everything &amp; close app"
        android:textColor="#FFFFFFFF" android:textSize="12sp" android:textStyle="bold" />
</LinearLayout>
