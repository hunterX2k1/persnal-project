diff --git a/src/hev-socks5-session.c b/src/hev-socks5-session.c
index e9d8458..4e611b9 100644
--- a/src/hev-socks5-session.c
+++ b/src/hev-socks5-session.c
@@ -16,6 +16,9 @@
 #include "hev-socks5-client.h"
 #include "hev-socks5-tunnel.h"
 
+#include <stdio.h>
+
+#include "hev-compiler.h"
 #include "hev-socks5-session.h"
 
 void
@@ -37,7 +40,17 @@ hev_socks5_session_run (HevSocks5Session *self)
     }
 
     if (srv->user && srv->pass) {
-        hev_socks5_client_set_auth (HEV_SOCKS5_CLIENT (self), srv->user,
+        HevSocks5SessionData *sd;
+        const char *user = srv->user;
+
+        sd = container_of (hev_socks5_session_get_node (self),
+                          HevSocks5SessionData, node);
+        if (sd->src[0]) {
+            snprintf (sd->auth_user, sizeof (sd->auth_user), "%s|%s",
+                      srv->user, sd->src);
+            user = sd->auth_user;
+        }
+        hev_socks5_client_set_auth (HEV_SOCKS5_CLIENT (self), user,
