diff --git a/src/hev-socks5-session-tcp.c b/src/hev-socks5-session-tcp.c
index 684b301..071915f 100644
--- a/src/hev-socks5-session-tcp.c
+++ b/src/hev-socks5-session-tcp.c
@@ -8,6 +8,7 @@
  */
 
 #include <errno.h>
+#include <stdio.h>
 #include <string.h>
 
 #include <lwip/tcp.h>
@@ -197,6 +198,15 @@ hev_socks5_session_tcp_new (struct tcp_pcb *pcb, HevTaskMutex *mutex)
         return NULL;
     }
 
+    /* BlockBridge: remember the app-side address (see HevSocks5SessionData) */
+    {
+        char ip[64];
+
+        if (ipaddr_ntoa_r (&pcb->remote_ip, ip, sizeof (ip)))
+            snprintf (self->data.src, sizeof (self->data.src), "T|%s|%u",
+                      ip, (unsigned int)pcb->remote_port);
+    }
+
     LOG_D ("%p socks5 session tcp new", self);
 
     return self;
