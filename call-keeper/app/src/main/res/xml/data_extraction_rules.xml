<?xml version="1.0" encoding="utf-8"?>
<!-- Call Keeper: settings may be backed up, call recordings and their index never leave the phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="recordings/" />
        <exclude domain="file" path="recordings_index.json" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="recordings/" />
        <exclude domain="file" path="recordings_index.json" />
    </device-transfer>
</data-extraction-rules>
